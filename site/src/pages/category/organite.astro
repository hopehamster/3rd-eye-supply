---
import Default from "../../layouts/Default.astro";

const products = [
  { href: "/products/golden-quartz-pyramid", name: "Golden Quartz Pyramid", img: "/images/pyramids/img_5469-cover.webp", price: "$55.00" },
  { href: "/products/amethyst-pyramid", name: "Amethyst Pyramid", img: "/images/pyramids/img_5474-cover.webp", price: "$65.00" },
  { href: "/products/black-tourmaline-pyramid", name: "Black Tourmaline Pyramid", img: "/images/pyramids/img_5477-cover.webp", price: "$60.00" },
  { href: "/products/clear-quartz-pyramid", name: "Clear Quartz Pyramid", img: "/images/pyramids/img_5484-cover.webp", price: "$50.00" },
  { href: "/products/orgone-necklace-energy-16", name: "Orgone Energy Necklace", img: "/images/orgone-jewelry/necklace_us_16__3_-cover.webp", price: "$16.00" },
  { href: "/products/orgone-necklace-healing-24", name: "Healing Orgone Necklace", img: "/images/orgone-jewelry/necklace_us_24-cover.webp", price: "$24.00" },
  { href: "/products/orgone-necklace-protection-30", name: "Protection Orgone Necklace", img: "/images/orgone-jewelry/necklace_us_30-cover.webp", price: "$30.00" },
  { href: "/products/orgone-necklace-premium-40", name: "Premium Orgone Necklace", img: "/images/orgone-jewelry/necklace_us_40-cover.webp", price: "$40.00" },
  { href: "/products/floral-wood-ring", name: "Floral Wood Ring", img: "/images/rings/img_6305-cover.webp", price: "$25.00" },
  { href: "/products/green-agate-ring", name: "Green Agate Ring", img: "/images/rings/img_6715-cover.webp", price: "$30.00" },
  { href: "/products/crystal-statement-ring", name: "Crystal Statement Ring", img: "/images/rings/img_6072-cover.webp", price: "$35.00" },
];
---
<Default title="Organite">
  <section class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-3xl font-bold mb-6">Organite</h1>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => (
        <article class="group rounded-lg border border-white/10 bg-white/5 overflow-hidden">
          <a href={p.href} class="block">
            <img src={p.img} alt={p.name} class="aspect-square w-full object-cover group-hover:opacity-95" loading="lazy" width="600" height="600" />
          </a>
          <div class="p-4">
            <a href={p.href} class="block text-base font-semibold">{p.name}</a>
            <div class="mt-3 flex items-center justify-between">
              <span class="text-lg font-semibold">{p.price}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Default>


