---
import Default from "../layouts/Default.astro";
---
<Default title="3rd Eye Supply">
  <section class="relative bg-gradient-to-br from-purple-900 via-indigo-900 to-black">
    <div class="mx-auto max-w-6xl px-4 py-24 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight">Feel Better, Live Brighter</n1>
      <p class="mt-4 text-white/80 max-w-2xl mx-auto">Handmade orgonite and crystal creations that calm your mind, shield your energy, and turn your home into a sanctuary.</p>
      <div class="mt-8">
        <a href="/shop" class="inline-flex items-center rounded-full bg-indigo-600 px-6 py-3 text-sm font-semibold hover:bg-indigo-500">Shop What Feels Right</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">Shop by Category</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/category/pyramids" class="group relative overflow-hidden rounded-lg border border-white/10">
        <img src="/images/pyramids/bulkresizephotos.com_pyramids-4-sided-1-cover.webp" alt="Pyramids" class="aspect-[4/3] w-full object-cover transition group-hover:scale-105" loading="lazy" width="800" height="600" />
        <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition"></div>
        <span class="absolute bottom-4 left-4 text-lg font-semibold">Pyramids</span>
      </a>
      <a href="/category/angels" class="group relative overflow-hidden rounded-lg border border-white/10">
        <img src="/images/angels/bulkresizephotos.com_angels-img-4503-cover.webp" alt="Angels" class="aspect-[4/3] w-full object-cover transition group-hover:scale-105" loading="lazy" width="800" height="600" />
        <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition"></div>
        <span class="absolute bottom-4 left-4 text-lg font-semibold">Angels</span>
      </a>
      <a href="/category/buddaz" class="group relative overflow-hidden rounded-lg border border-white/10">
        <img src="/images/buddaz/buddhas-img-4391-cover.webp" alt="Buddha" class="aspect-[4/3] w-full object-cover transition group-hover:scale-105" loading="lazy" width="800" height="600" />
        <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition"></div>
        <span class="absolute bottom-4 left-4 text-lg font-semibold">Buddha</span>
      </a>
      <a href="/category/starfish" class="group relative overflow-hidden rounded-lg border border-white/10">
        <img src="/images/starfish/starfish-img-4833-cover.webp" alt="Starfish" class="aspect-[4/3] w-full object-cover transition group-hover:scale-105" loading="lazy" width="800" height="600" />
        <div class="absolute inset-0 bg-black/30 group-hover:bg-black/40 transition"></div>
        <span class="absolute bottom-4 left-4 text-lg font-semibold">Starfish</span>
      </a>
    </div>
  </section>
</Default>


