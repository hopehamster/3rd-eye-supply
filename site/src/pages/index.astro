---
import DefaultLayout from '../layouts/Default.astro';
import ProductGrid from '../components/ProductGrid.astro';
import productsData from '../data/products.json';

// Get featured products (first 6 for showcase)
const featuredProducts = productsData.slice(0, 6);
---

<DefaultLayout title="3rd Eye Supply - Handmade Orgonite & Crystal Creations">
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-purple-900 via-indigo-900 to-black min-h-screen flex items-center overflow-hidden">
      <div class="absolute inset-0 bg-[url('/images/hero-pattern.svg')] opacity-10"></div>
      <div class="relative mx-auto max-w-7xl px-4 py-24 text-center">
        <div class="mb-8">
          <span class="inline-block px-4 py-2 bg-indigo-600/20 border border-indigo-400/30 rounded-full text-indigo-200 text-sm font-medium mb-6">
            ✨ Handcrafted with Intention
          </span>
        </div>
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-8 bg-gradient-to-r from-white via-purple-200 to-indigo-200 bg-clip-text text-transparent">
          Transform Your Energy
        </h1>
        <p class="text-xl md:text-2xl text-white/70 max-w-4xl mx-auto mb-12 leading-relaxed">
          Discover our collection of handmade orgonite pyramids, pendants, and crystal creations designed to harmonize your space and elevate your vibration.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center mb-16">
          <a href="/shop" class="group inline-flex items-center justify-center rounded-full bg-gradient-to-r from-indigo-600 to-purple-600 px-10 py-5 text-lg font-semibold text-white hover:from-indigo-500 hover:to-purple-500 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl">
            <span>Shop Collection</span>
            <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a href="/category/organite" class="inline-flex items-center justify-center rounded-full border-2 border-white/30 px-10 py-5 text-lg font-semibold text-white hover:bg-white/10 hover:border-white/50 transition-all">
            Learn About Orgonite
          </a>
        </div>
        
        <!-- Trust Indicators -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          <div class="text-center">
            <div class="w-16 h-16 bg-indigo-600/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Handcrafted Quality</h3>
            <p class="text-white/60">Each piece is carefully made with premium crystals and metals</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 bg-indigo-600/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Made with Love</h3>
            <p class="text-white/60">Infused with positive intention and healing energy</p>
          </div>
          <div class="text-center">
            <div class="w-16 h-16 bg-indigo-600/20 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">Fast Shipping</h3>
            <p class="text-white/60">Quick and secure delivery to your doorstep</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What is Orgonite Section -->
    <section class="py-20 bg-gradient-to-b from-gray-900 to-black">
      <div class="mx-auto max-w-6xl px-4">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-purple-400 to-indigo-400 bg-clip-text text-transparent">
            What is Orgonite?
          </h2>
          <p class="text-xl text-white/70 max-w-3xl mx-auto">
            Orgonite is a powerful tool for transforming negative energy into positive, life-enhancing energy. Our handcrafted pieces combine crystals, metals, and resin to create beautiful, functional art.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h3 class="text-2xl font-bold text-white mb-6">Benefits of Orgonite:</h3>
            <ul class="space-y-4">
              <li class="flex items-start">
                <svg class="w-6 h-6 text-indigo-400 mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-white/80">Neutralizes electromagnetic pollution (EMF)</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-indigo-400 mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-white/80">Promotes better sleep and relaxation</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-indigo-400 mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-white/80">Enhances meditation and spiritual practices</span>
              </li>
              <li class="flex items-start">
                <svg class="w-6 h-6 text-indigo-400 mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-white/80">Creates a more harmonious living environment</span>
              </li>
            </ul>
          </div>
          <div class="relative">
            <img 
              src="/images/pyramids/bulkresizephotos.com_pyramids-4-sided-1-cover.webp" 
              alt="Orgonite Pyramid" 
              class="rounded-lg shadow-2xl"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-purple-900/20 to-transparent rounded-lg"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Products -->
    {featuredProducts.length > 0 && (
      <section class="py-20 bg-black">
        <div class="mx-auto max-w-7xl px-4">
          <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-purple-400 to-indigo-400 bg-clip-text text-transparent">
              Featured Collection
            </h2>
            <p class="text-xl text-white/70 max-w-3xl mx-auto">
              Discover our most popular orgonite creations, each one carefully crafted to bring harmony and positive energy to your life.
            </p>
          </div>
          <ProductGrid products={featuredProducts} />
          <div class="text-center mt-12">
            <a href="/shop" class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-indigo-600 to-purple-600 px-8 py-4 text-lg font-semibold text-white hover:from-indigo-500 hover:to-purple-500 transition-all transform hover:scale-105">
              View All Products
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Newsletter Section -->
    <section class="py-20 bg-gradient-to-r from-purple-900 to-indigo-900">
      <div class="mx-auto max-w-4xl px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Stay Connected to Higher Vibrations
        </h2>
        <p class="text-xl text-white/70 mb-8">
          Join our community and receive updates on new products, spiritual insights, and exclusive offers.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
          <input 
            type="email" 
            placeholder="Enter your email" 
            class="flex-1 px-6 py-4 rounded-full bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent"
          />
          <button class="px-8 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-full transition-colors">
            Subscribe
          </button>
        </div>
      </div>
    </section>
  </main>
</DefaultLayout>