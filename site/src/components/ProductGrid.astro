---
const { products } = Astro.props as { products: Array<{slug:string,name:string,price:number,img:string,shape?:string}> };
---
<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {products.map((p) => (
    <article class="group rounded-lg border border-white/10 bg-white/5 overflow-hidden" data-shape={p.shape || ''}>
      <a href={`/products/${p.slug}`} class="block">
        <img src={p.img} alt={p.name} class="aspect-square w-full object-cover group-hover:opacity-95" loading="lazy" width="600" height="600" />
      </a>
      <div class="p-4">
        <a href={`/products/${p.slug}`} class="block text-base font-semibold">{p.name}</a>
        <div class="mt-3 flex items-center justify-between">
          <span class="text-lg font-semibold">${p.price.toFixed(2)}</span>
        </div>
      </div>
    </article>
  ))}
</div>


