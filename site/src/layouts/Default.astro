---
import "../styles/global.css";
const title = Astro.props.title ?? "3rd Eye Supply";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#2a0845" />
    <meta name="description" content="Feel grounded, protected and inspired. Handcrafted orgonite, crystal pyramids, rings and incense designed to elevate your energy and your space." />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="https://cdn.snipcart.com/themes/v3.4.1/default/snipcart.css" />
  </head>
  <body class="bg-black text-white min-h-screen flex flex-col">
    <nav class="w-full sticky top-0 z-40 bg-black/70 backdrop-blur border-b border-white/10">
      <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-lg font-semibold tracking-wide">3rd Eye Supply</a>
        <ul class="hidden md:flex items-center gap-6">
          <li><a class="text-sm text-white/90 hover:text-white" href="/">Home</a></li>
          <li><a class="text-sm text-white/90 hover:text-white" href="/shop">Shop</a></li>
          <li><a class="text-sm text-white/90 hover:text-white" href="/category/organite">Organite</a></li>
        </ul>
        <a href="#" class="snipcart-checkout inline-flex items-center gap-2 rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium hover:bg-indigo-500">Cart</a>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-white/10 bg-black/60">
      <div class="mx-auto max-w-6xl px-4 py-10 text-center text-sm text-white/70">
        <p>Contact: <a class="underline" href="mailto:support@3rdeyesupply.com">support@3rdeyesupply.com</a></p>
        <p class="mt-2">© 2025 3rd Eye Supply. All rights reserved.</p>
      </div>
    </footer>

    <div id="snipcart" hidden data-api-key="NmEzNGJkYjMtZWRlYS00NDIyLWE3MjktZWNjNzZlYzYyMzk2NjM4ODA4MzQ5NDA4MzExMTQ2"></div>
    <script defer src="https://cdn.snipcart.com/themes/v3.4.1/default/snipcart.js"></script>
  </body>
  
</html>


